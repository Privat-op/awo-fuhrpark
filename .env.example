# Produktivkonfiguration – bitte vollständig anpassen
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_PORT=3000
TRUST_PROXY=0
COOKIE_SECURE=false
TZ=Europe/Berlin

# Mindestens 32 Zeichen. Erzeugen z. B. mit: openssl rand -hex 32
SESSION_SECRET=

# Wird nur beim allerersten Start benötigt, solange noch kein Benutzer existiert.
ADMIN_NAME=Fuhrparkleitung
ADMIN_EMAIL=fuhrpark@example.org
ADMIN_PASSWORD=

# Superadmin-Datei (JSON mit email, name, passwordHash als bcrypt-Hash, Cost 12).
# Docker-Default: /run/secrets/awo-superadmin.json; sonst /etc/awo-fuhrpark/superadmin.json.
# Datei außerhalb von Repo, Daten-Volume und Backup ablegen, root:root 0600.
# SUPERADMIN_FILE=/etc/awo-fuhrpark/superadmin.json

# Organisationsdaten für die Erstinstallation
ORG_NAME=AWO Bremerhaven
ORG_LOCATION=Bremerhaven
ORG_EMAIL=fuhrpark@example.org
ORG_PHONE=
