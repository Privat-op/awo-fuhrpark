# Produktivkonfiguration – bitte vollständig anpassen
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_PORT=3000
TRUST_PROXY=0
COOKIE_SECURE=false
TZ=Europe/Berlin

# Mindestens 32 Zeichen. Erzeugen z. B. mit: openssl rand -hex 32
SESSION_SECRET=

# Öffentliche Basis-URL für Links in Passwort-Reset-Mails.
# APP_BASE_URL=https://fuhrpark.example.org

# Wartungs-/TÜV-Erinnerungen (Intervall in Millisekunden, Standard 6 Stunden).
# REMINDER_INITIAL_DELAY_MS=5000
# REMINDER_INTERVAL_MS=21600000
# REMINDER_SCHEDULER_DISABLED=true

# Optional: 32 Byte als Base64 oder 64 Hex-Zeichen für die MFA-Verschlüsselung.
# Fehlt der Wert, wird DATA_DIR/mfa.key automatisch erzeugt und muss mit der DB gesichert werden.
# MFA_ENCRYPTION_KEY=

# Passkeys/WebAuthn. Ohne vollständige Konfiguration sind die Passkey-Endpunkte deaktiviert.
# WEBAUTHN_RP_ID=fuhrpark.example.org
# WEBAUTHN_RP_NAME=AWO Fuhrparkmanagement
# WEBAUTHN_ORIGIN=https://fuhrpark.example.org

# Optionales OIDC-SSO (z. B. Microsoft Entra ID). Standardmäßig deaktiviert.
# SSO_ENABLED=0
# SSO_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=https://fuhrpark.example.org/auth/sso/callback
# SSO_SCOPES=openid profile email
# SSO_ALLOWED_DOMAINS=example.org
# SSO_AUTO_PROVISION=0
# SSO_DEFAULT_ROLE=manager
# SSO_GROUP_CLAIM=groups
# SSO_ADMIN_GROUP=
# SSO_MANAGER_GROUP=

# Optionaler Microsoft-Teams-Incoming-Webhook (ohne Graph/App-Registration).
# TEAMS_WEBHOOK_URL=

# Wird nur beim allerersten Start benötigt, solange noch kein Benutzer existiert.
ADMIN_NAME=Fuhrparkleitung
ADMIN_EMAIL=fuhrpark@example.org
ADMIN_PASSWORD=

# Superadmin-Datei (JSON mit email, name, passwordHash als bcrypt-Hash, Cost 12).
# Docker-Default: /run/secrets/awo-superadmin.json; sonst /etc/awo-fuhrpark/superadmin.json.
# Datei außerhalb von Repo, Daten-Volume und Backup ablegen, root:root 0600.
# SUPERADMIN_FILE=/etc/awo-fuhrpark/superadmin.json

# Organisationsdaten für die Erstinstallation
ORG_NAME=AWO Bremerhaven
ORG_LOCATION=Bremerhaven
ORG_EMAIL=fuhrpark@example.org
ORG_PHONE=
